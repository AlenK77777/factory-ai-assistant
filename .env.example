# Copy this file to .env and set your own values (PowerShell):
#   Copy-Item .env.example .env
# .env is git-ignored. Never commit real passwords.

# Used by docker-compose.yml to create the database on first start.
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=factory

# Used by the Python scripts on Windows to reach the container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
