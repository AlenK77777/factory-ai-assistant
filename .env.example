# Copy this file to .env and set your own values (PowerShell):
#   Copy-Item .env.example .env
# .env is git-ignored. Never commit real passwords.

# Used by docker-compose.yml to create the database on first start.
POSTGRES_USER=factory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=factory

# Used by the Python scripts on Windows to reach the container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Read-only role used by the MCP server (created by db/init/02_readonly_role.sql).
MCP_DB_USER=factory_readonly
MCP_DB_PASSWORD=change-me-readonly

# Rebuilds the instruction index only. Not a superuser. Cannot change orders or defects.
# Created by db/init/04_indexer_role.sql.
INDEX_DB_USER=factory_indexer
INDEX_DB_PASSWORD=change-me-indexer

# Local Ollama server (runs natively on Windows) for embeddings and the local chat model.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b

# Password for the admin panel at https://localhost:8443/admin (NGINX basic auth).
# scripts/generate_certs.ps1 writes nginx/auth/htpasswd from these values.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
